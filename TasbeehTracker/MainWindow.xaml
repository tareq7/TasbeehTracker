<Window x:Class="TasbeehTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasbeeh Tracker" Height="130" Width="120"
        WindowStyle="None" Topmost="True" 
        Background="Transparent" AllowsTransparency="True"
        MouseDown="Window_MouseDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Segoe UI Variable">
    
    <Window.Resources>
        <!-- Soft Outer Glow Shadow for the Orb -->
        <DropShadowEffect x:Key="OrbGlowEffect" BlurRadius="12" ShadowDepth="0" Opacity="0.55" Color="DeepSkyBlue"/>
        
        <!-- Standard Shadow for text legibility -->
        <DropShadowEffect x:Key="TextShadow" BlurRadius="4" ShadowDepth="1" Opacity="0.5" Color="Black"/>

        <!-- Count Increment Storyboard (Scale Bounce + Glow Flare) -->
        <Storyboard x:Key="IncrementAnimation">
            <!-- Scale X Bounce -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CountTextScale" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.35">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <!-- Scale Y Bounce -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CountTextScale" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.35">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <!-- Border Glow Pulse -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OrbGlow" Storyboard.TargetProperty="BlurRadius">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="12"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="24"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="12">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid" ToolTip="Right-click for options (Change Hotkey, Reset)">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Change Hotkey..." Click="ChangeHotkey_Click" />
                <MenuItem Header="Reset Counter" Click="ResetButton_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="CloseButton_Click" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Triggers to handle smooth fade-in/fade-out of buttons on Mouse Hover -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ControlsPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Grid.MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ControlsPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!-- Main Orb Design -->
        <Border x:Name="OrbBorder" Width="106" Height="106" CornerRadius="53"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1.5" Margin="0">
            <Border.Effect>
                <DropShadowEffect x:Name="OrbGlow" BlurRadius="12" ShadowDepth="0" Opacity="0.6" Color="DeepSkyBlue"/>
            </Border.Effect>

            <Grid>
                <!-- Dynamic Counter Text (centered) -->
                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center" Width="68" Height="68" Margin="0,-4,0,0">
                    <TextBlock x:Name="CountText" Text="0" FontWeight="Bold" 
                               Foreground="{DynamicResource ForegroundBrush}"
                               Effect="{StaticResource TextShadow}"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <!-- Render transform for scaling bounce animation -->
                            <ScaleTransform x:Name="CountTextScale" ScaleX="1.0" ScaleY="1.0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Viewbox>

                <!-- 4. Hover Controls Panel (Close & Reset Buttons, fades in on hover) -->
                <Grid x:Name="ControlsPanel" Opacity="0">
                    <!-- Close Button floating at top-center of orb -->
                    <Button x:Name="CloseButton" Content="✕" Click="CloseButton_Click" 
                            HorizontalAlignment="Center" VerticalAlignment="Top" 
                            Width="18" Height="18" Margin="0,8,0,0" FontSize="9" FontWeight="Bold"
                            Background="#88000000" BorderBrush="#33FFFFFF" BorderThickness="1" 
                            Foreground="White" Cursor="Hand" ToolTip="Close Tracker">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="9"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CCFF3B30"/>
                                        <Setter Property="BorderBrush" Value="#FFFF3B30"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Reset Button floating at bottom-center of orb -->
                    <Button x:Name="ResetButton" Content="Reset" Click="ResetButton_Click" 
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                            Width="54" Height="18" Margin="0,0,0,8" FontSize="9" FontWeight="Medium"
                            Background="#88000000" BorderBrush="#33FFFFFF" BorderThickness="1" 
                            Foreground="White" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="9"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#88FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Hotkey Changer Overlay View (renders on top of the orb when active) -->
                <Grid x:Name="SettingsGrid" Visibility="Collapsed" Background="#D8000000" ClipToBounds="True">
                    <Grid.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="53"/>
                        </Style>
                    </Grid.Resources>
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <TextBlock x:Name="SettingsStatusText" Text="Press new hotkey..." 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   TextAlignment="Center" TextWrapping="Wrap" Foreground="White"
                                   FontSize="10" FontWeight="Medium" Margin="4,8,4,0"/>
                        
                        <Button x:Name="CancelSettingsButton" Grid.Row="1" Content="Cancel" Click="CancelSettingsButton_Click"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="50" Height="18" FontSize="9" FontWeight="Medium"
                                Background="#44FFFFFF" Foreground="White" BorderThickness="0"
                                Margin="0,0,0,4" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="9"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>